225 0 obj
<<
/Type /StructElem
/S /H1
/T (WITH m AS \(SELECT list_price,            ROW_NUMBER\(\) OVER \(ORDER BY list_price\) AS rn,            COUNT\(list_price\) OVER \(\) AS cn     FROM order_items\) SELECT CASE   WHEN cn % 2 = 0 THEN \(SELECT AVG\(list_price\) FROM m WHERE rn IN \(cn/2, \(cn/2\) + 1\)\)   ELSE \(SELECT list_price FROM m WHERE rn = \(cn + 1\)/2\)  END AS median from m limit 1;)
/E (WITH m AS \(SELECT list_price,            ROW_NUMBER\(\) OVER \(ORDER BY list_price\) AS rn,            COUNT\(list_price\) OVER \(\) AS cn     FROM order_items\) SELECT CASE   WHEN cn % 2 = 0 THEN \(SELECT AVG\(list_price\) FROM m WHERE rn IN \(cn/2, \(cn/2\) + 1\)\)   ELSE \(SELECT list_price FROM m WHERE rn = \(cn + 1\)/2\)  END AS median from m limit 1;)
/Pg 17 0 R
/K [2]
>>
endobj
