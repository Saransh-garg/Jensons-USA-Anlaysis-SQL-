/Type /StructElem
/S /H1
/T (SELECT staffs.staff_id, COALESCE\(SUM\(order_items.quantity * \(order_items.list_price - order_items.discount\)\), 0\) AS sales FROM orders RIGHT JOIN staffs ON staffs.staff_id = orders.staff_id LEFT JOIN order_items ON orders.order_id = order_items.order_id GROUP BY staffs.staff_id HAVING SUM\(order_items.quantity * \(order_items.list_price - order_items.discount\)\) >  \(SELECT AVG\(sales\) FROM      \(SELECT staffs.staff_id,    COALESCE\(SUM\(order_items.quantity * \(order_items.list_price - order_items.discount\)\), 0\) AS sales         FROM orders         RIGHT JOIN staffs ON staffs.staff_id = orders.staff_id         LEFT JOIN order_items ON orders.order_id = order_items.order_id         GROUP BY staffs.staff_id\) AS c\);)
/E (SELECT staffs.staff_id, COALESCE\(SUM\(order_items.quantity * \(order_items.list_price - order_items.discount\)\), 0\) AS sales FROM orders RIGHT JOIN staffs ON staffs.staff_id = orders.staff_id LEFT JOIN order_items ON orders.order_id = order_items.order_id GROUP BY staffs.staff_id HAVING SUM\(order_items.quantity * \(order_items.list_price - order_items.discount\)\) >  \(SELECT AVG\(sales\) FROM      \(SELECT staffs.staff_id,    COALESCE\(SUM\(order_items.quantity * \(order_items.list_price - order_items.discount\)\), 0\) AS sales         FROM orders         RIGHT JOIN staffs ON staffs.staff_id = orders.staff_id         LEFT JOIN order_items ON orders.order_id = order_items.order_id         GROUP BY staffs.staff_id\) AS c\);)
/Pg 19 0 R
/K [2]
>>
